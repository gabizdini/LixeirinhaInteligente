# =====================================================
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).
# =====================================================

# Endereço do broker MQTT.
# O backend roda no MESMO computador do Docker, então "localhost" funciona.
# (A ESP32 é que precisa do IP do computador, ex.: 192.168.18.5)
MQTT_URL=mqtt://localhost:1883

# Usuário e senha do broker (deixe vazio se o HiveMQ local não usa autenticação)
MQTT_USERNAME=
MQTT_PASSWORD=

# Tópicos
MQTT_TOPIC=pinkbin/lixeira/dados
MQTT_TOPIC_PREVISAO=pinkbin/previsao

# Segundos sem receber dados até considerar a ESP32 desconectada
DEVICE_TIMEOUT_S=30

# Porta do dashboard (abra http://localhost:3000)
PORT=3000
